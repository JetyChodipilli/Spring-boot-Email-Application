# Copy to .env in the project root. Do not commit secrets.
# For REAL Gmail SMTP, enter your own Gmail and Google App Password:
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=yourname@gmail.com
SMTP_PASSWORD=your_google_app_password

SMTP_FROM_ADDRESS=yourname@gmail.com
APP_ALLOWED_FROM=yourname@gmail.com
APP_ALLOW_LOCAL_MAILPIT=false

# For local testing use SMTP_HOST=localhost, SMTP_PORT=1025,
# SMTP_AUTH=false and SMTP_STARTTLS=false, and run Mailpit separately.
# Docker Compose overrides the SMTP target with its local Mailpit container.
